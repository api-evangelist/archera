                  "key": "file",
                  "type": "file",
                  "description": "(Required) Billing PDF or CSV file to upload for savings analysis"
                },
                {
                  "key": "description",
                  "value": "<string,null>",
                  "type": "text",
                  "description": "Optional partner-supplied context for the uploaded billing file"
                }
              ]
            }

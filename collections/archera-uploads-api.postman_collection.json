        {
          "id": "b9e75dc1-1769-48e1-b116-92555daaf039",
          "name": "Upload a billing file for savings analysis",
          "request": {
            "name": "Upload a billing file for savings analysis",
            "description": {
              "content": "Accepts a multipart PDF or CSV billing file, stores it in Archera's invoice upload bucket, and returns an upload ID. Use this upload ID when invoking the Savings Analysis MCP tool. The upload status workflow is: PENDING before storage begins, PROCESSING while the file is being transferred, COMPLETE once it is available for analysis, and ERROR if storage fails.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "org",
                ":org_id",
                "uploads"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "org_id",
                  "description": "(Required) "
                }
              ]
            },
